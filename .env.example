# AWS Configuration
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_USER_POOL_ID=your_cognito_user_pool_id
NEXT_PUBLIC_AWS_USER_POOL_CLIENT_ID=your_cognito_client_id
NEXT_PUBLIC_AWS_S3_BUCKET=your_s3_bucket_name
NEXT_PUBLIC_AWS_API_ENDPOINT=https://your-api-gateway-url.amazonaws.com/prod

# App Config
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_DEMO_MODE=true
